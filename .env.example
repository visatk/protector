# Required to run the live bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: Point to a self-hosted Telegram Local Bot API Server (lifts 20MB download limit to 20GB)
TELEGRAM_API_BASE_URL=https://api.telegram.org

# SQLite WAL database path
AEGIS_DB_PATH=data/aegistg.db

# Optional: Private channel/group ID for instant Owner Security Alerts (hijacks, raids, critical blocks)
AEGIS_OWNER_ALERT_CHAT_ID=

# Required by Telegram Bot Developer ToS Section 4 (register this same URL in @BotFather)
AEGIS_PRIVACY_POLICY_URL=https://your-domain.example/privacy

# Webhook settings (only needed for `python3 -m protector webhook`)
AEGIS_WEBHOOK_URL=
AEGIS_WEBHOOK_HOST=0.0.0.0
AEGIS_WEBHOOK_PORT=8443
AEGIS_WEBHOOK_SECRET=change-me-to-a-long-random-token

# Optional: Enable live CAS (Combot Anti-Spam) lookups
AEGIS_CAS_ENABLED=false

# Optional: Pluggable Gray-Zone Semantic AI Judge (invoked ONLY for ambiguous risk scores 35-74; PII-redacted)
# AEGIS_AI_PROVIDER=openai_compatible   # or "gemini"
# AEGIS_AI_BASE_URL=https://api.openai.com/v1
# AEGIS_AI_MODEL=gpt-4o-mini
# AEGIS_AI_API_KEY=
